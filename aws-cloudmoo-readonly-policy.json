{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2AndVPCReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AutoScalingReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "autoscaling:DescribeAutoScalingGroups"
            ],
            "Resource": "*"
        },
        {
            "Sid": "RDSReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDB*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "LambdaReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "lambda:ListFunctions",
                "lambda:GetFunction"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DynamoDBReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:ListTables",
                "dynamodb:DescribeTable"
            ],
            "Resource": "*"
        },
        {
