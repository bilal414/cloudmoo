{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EC2AndVPCReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AutoScalingReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "autoscaling:DescribeAutoScalingGroups"
            ],
            "Resource": "*"
        },
        {
            "Sid": "RDSReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "rds:DescribeDB*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "LambdaReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "lambda:ListFunctions",
                "lambda:GetFunction"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DynamoDBReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "dynamodb:ListTables",
                "dynamodb:DescribeTable"
            ],
            "Resource": "*"
        },
        {
            "Sid": "S3ReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration",
                "s3:GetBucketPublicAccessBlock"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CloudWatchReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:DescribeAlarms",
                "cloudwatch:ListMetrics",
                "cloudwatch:GetMetricData",
                "cloudwatch:GetMetricStatistics"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CloudWatchLogsReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "logs:DescribeLogGroups"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECRReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "ecr:Describe*",
                "ecr:List*",
                "ecr:Scan*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECSReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "ecs:List*",
                "ecs:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EKSReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "eks:List*",
                "eks:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AppRunnerReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "apprunner:List*",
                "apprunner:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ACMReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "acm:List*",
                "acm:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "Route53ReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "route53:List*",
                "route53:Get*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CloudFrontReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "cloudfront:List*",
                "cloudfront:Get*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "WAFv2ReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "wafv2:List*",
                "wafv2:Get*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "GlobalAcceleratorReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "globalaccelerator:List*",
                "globalaccelerator:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "BackupReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "backup:List*",
                "backup:Describe*",
                "backup:Get*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ELBReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "elasticloadbalancing:Describe*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "STSReadOnlyAccess",
            "Effect": "Allow",
            "Action": [
                "sts:GetCallerIdentity"
            ],
            "Resource": "*"
        }
    ]
}
