# ---------------------------------------------------------------------------
# CloudMoo configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# All settings can also be provided as real environment variables, or as a
# JSON blob in the AWS_SECRETS environment variable (handy on AWS).
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# true only for local development — never in production
DJANGO_DEBUG=true
# Environment name shown in error tracking (development / staging / production)
DJANGO_SERVER=development
# Comma-separated list of hostnames the instance answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of origins trusted for CSRF (needed when served over HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Public URL of this instance (used in email links)
APP_DOMAIN=localhost:8000
APP_PROTOCOL=http://

# Set true when serving the app over HTTPS (enables secure cookies, HSTS, SSL redirect)
HTTPS_ENABLED=false

# --- Database (PostgreSQL) -------------------------------------------------
DB_NAME=cloudmoo
DB_USER=cloudmoo
DB_PASSWORD=cloudmoo
DB_HOST=localhost
DB_PORT=5432

# --- Registration ----------------------------------------------------------
# Set to false to disable public sign-ups on this instance
REGISTRATION_OPEN=true

# --- Email -----------------------------------------------------------------
# Any Django email backend works.
# Development default: django.core.mail.backends.console.EmailBackend (prints to console)
# Production default: SMTP via the settings below.
# For AWS SES: EMAIL_BACKEND=django_ses.SESBackend (django-ses is included).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=CloudMoo <noreply@example.com>

# --- AWS monitoring engine --------------------------------------------------
# Used for EventBridge scheduling, DynamoDB status storage and Lambda checks.
# Leave keys empty to use the default boto3 credential chain
# (IAM role, instance profile, ~/.aws/credentials).
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# IAM role ARN that EventBridge Scheduler assumes to invoke the Lambda functions
AWS_SCHEDULER_ROLE=
# ARNs of the deployed monitoring Lambda functions (see _lambda/)
AWS_LAMBDA_ASSET_STATUS=
AWS_LAMBDA_CLOUD_SYNC_ASSETS=
AWS_LAMBDA_EMAIL_ASSET_STATUS_CHANGE=
# DynamoDB table names for status data
AWS_DYNAMODB_ASSETS_TABLE=cloudmoo-assets
AWS_DYNAMODB_ASSET_LOGS_TABLE=cloudmoo-asset-logs
AWS_DYNAMODB_ASSET_EMAILS_TABLE=cloudmoo-asset-emails

# Shared secret for internal webhook calls (Lambda -> Django).
# Generate a long random string and configure the same value in your Lambda functions.
CLOUDMOO_API_KEY=

# --- Optional: Google reCAPTCHA v3 ------------------------------------------
# When unset, signup/login forms work without reCAPTCHA
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Optional: Sentry error tracking ----------------------------------------
# When unset, Sentry is disabled
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
