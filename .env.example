# ---------------------------------------------------------------------------
# CloudMoo configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# All settings can also be provided as real environment variables, or as a
# JSON blob in the CLOUDMOO_SECRETS environment variable.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# true only for local development — never in production
DJANGO_DEBUG=true
# Environment name shown in error tracking (development / staging / production)
DJANGO_SERVER=development
# Comma-separated list of hostnames the instance answers to
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of origins trusted for CSRF (needed when served over HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Public URL of this instance (used in email links)
APP_DOMAIN=localhost:8000
APP_PROTOCOL=http://

# Set true when serving the app over HTTPS (enables secure cookies, HSTS, SSL redirect)
HTTPS_ENABLED=false

# --- Database (PostgreSQL) -------------------------------------------------
DB_NAME=cloudmoo
DB_USER=cloudmoo
DB_PASSWORD=cloudmoo
DB_HOST=localhost
DB_PORT=5432

# --- Registration ----------------------------------------------------------
# Set to false to disable public sign-ups on this instance
REGISTRATION_OPEN=true

# --- Email -----------------------------------------------------------------
# Any Django email backend works.
# Development default: django.core.mail.backends.console.EmailBackend (prints to console)
# Production default: SMTP via the settings below.
# For AWS SES: EMAIL_BACKEND=django_ses.SESBackend (django-ses is included).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
DEFAULT_FROM_EMAIL=CloudMoo <noreply@example.com>

# --- Queue (Celery broker) --------------------------------------------------
# Task queue used by the monitoring engine (status checks, cloud syncs,
# notification emails).
# docker-compose default: amqp://guest:guest@rabbitmq:5672//
# On Heroku the CLOUDAMQP_URL add-on variable is picked up automatically.
# Alternative: set RABBITMQ_HOST (plus optional RABBITMQ_USER, RABBITMQ_PASSWORD,
# RABBITMQ_PORT, RABBITMQ_VHOST) to assemble the URL from parts.
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Optional shared secret for the external sync webhook (X-API-KEY header).
# Generate a long random string; external schedulers use it to trigger cloud syncs.
CLOUDMOO_API_KEY=

# --- Optional: Google reCAPTCHA v3 ------------------------------------------
# When unset, signup/login forms work without reCAPTCHA
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# --- Optional: Sentry error tracking ----------------------------------------
# When unset, Sentry is disabled
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
